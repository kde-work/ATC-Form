APP_NAME="ATC Form"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://atc.form
APP_BIND_IP=127.0.0.5
APP_PORT=80

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=atc_form
DB_USERNAME=atc
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret
FORWARD_DB_PORT=3306

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=atc.form

SANCTUM_STATEFUL_DOMAINS=atc.form

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
FORWARD_MAILPIT_DASHBOARD_PORT=8025

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5173
ANGULAR_PORT=4200

WWWUSER=1000
WWWGROUP=1000
XDEBUG_MODE=off

ADMIN_EMAIL=admin@atc.form
ADMIN_PASSWORD=password

# Лимит загрузки XLSX в байтах. Default 5 MB.
TARIFF_IMPORT_MAX_BYTES=5242880
